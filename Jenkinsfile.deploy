// JOB 2: "portal-deploy" -> stack par deploy / update. Script Path: Jenkinsfile.deploy
// Volumes (portal_pgdata, portal_uploads) kabhi delete nahi hotay (down -v nahi chalta).
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters { string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Deploy karne wala image tag') }
  environment {
    IMAGE_TAG = "${params.IMAGE_TAG}"
    LAST_GOOD = "${env.JENKINS_HOME}/portal_last_good_tag"
  }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Deploy stack') {
      steps {
        withCredentials([file(credentialsId: 'portal-env', variable: 'ENV_FILE')]) {
          sh '''
            cp "$ENV_FILE" .env
            # Naye image se sirf badle hue containers recreate hotay hain, volumes wahi rehte hain
            IMAGE_TAG=$IMAGE_TAG docker compose up -d --remove-orphans
          '''
        }
      }
    }

    stage('Health check') {
      steps {
        sh '''
          for i in $(seq 1 30); do
            if docker compose exec -T backend node -e "fetch('http://localhost:3000/api/categories').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"; then
              echo "Backend healthy"; echo "$IMAGE_TAG" > "$LAST_GOOD"; exit 0
            fi
            sleep 5
          done
          echo "Health check failed"; exit 1
        '''
      }
    }
  }

  post {
    success { sh 'docker image prune -f; rm -f .env' }
    failure {
      // Naya version fail ho to pichla chalta hua version wapis (data volumes wahi, koi loss nahi)
      sh '''
        if [ -f "$LAST_GOOD" ]; then
          PREV=$(cat "$LAST_GOOD"); echo "Rolling back to tag $PREV"
          IMAGE_TAG=$PREV docker compose up -d --remove-orphans || true
        fi
        rm -f .env
      '''
    }
  }
}
