generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
  TEACHER
}

enum UserStatus {
  ACTIVE
  WARNED
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  status        UserStatus     @default(ACTIVE)
  warnings      Int            @default(0)
  createdAt     DateTime       @default(now())
  lastLogin     DateTime?
  enrollments   Enrollment[]
  reviews       Review[]
  notifications Notification[]
  lastSeen      DateTime?
  loginCount    Int            @default(0)
  failedLogins  Int            @default(0)
  activities    Activity[]
  payments      PaymentRequest[]
  labAttempts   LabAttempt[]
  suspendedUntil DateTime?
  suspendReason  String?
  failedStreak   Int           @default(0)
  fatherName     String?
  phone          String?
  progress      LessonProgress[]
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
  showInHeader  Boolean @default(true)
  showInCourses Boolean @default(true)
  order         Int     @default(0)
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String
  price       Float        @default(0)
  thumbnail   String?
  published   Boolean      @default(true)
  plan        String       @default("FREE")
  teacherId   String?
  durationDays Int         @default(0)
  createdAt   DateTime     @default(now())
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  enrollments Enrollment[]
  payments    PaymentRequest[]
  labs        Lab[]
}

model Lesson {
  id        String       @id @default(uuid())
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  video     String      @default("")
  videoUrl  String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  section     String?
  description String?
  files     LessonFile[]
  progress  LessonProgress[]
}

model LessonFile {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name     String
  path     String
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  revokedAt  DateTime?
  celebrated Boolean  @default(true)

  @@unique([userId, courseId])
}

model Slide {
  id      String  @id @default(uuid())
  image   String
  caption String?
  order   Int     @default(0)
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  sender    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Section {
  id      String  @id @default(uuid())
  type    String
  data    Json
  visible Boolean @default(true)
  order   Int     @default(0)
}

model Activity {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  type      String
  ip        String?
  agent     String?
  createdAt DateTime @default(now())
}

model PaymentRequest {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers    Json
  amount     Float     @default(0)
  days       Int       @default(0)
  fatherName String    @default("")
  phone      String    @default("")
  gateway    String?
  txnRef     String?
  gatewayInfo Json?
  status     String    @default("PENDING")
  note       String?
  createdAt  DateTime  @default(now())
  dueAt      DateTime
  reviewedAt DateTime?
}

model Lab {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String       @default("")
  kind          String       @default("Quiz")
  timeLimitMin  Int          @default(0)
  passPercent   Int          @default(60)
  published     Boolean      @default(true)
  order         Int          @default(0)
  items         Json
  createdAt     DateTime     @default(now())
  attempts      LabAttempt[]
}

model LabAttempt {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  percent   Int
  passed    Boolean
  createdAt DateTime @default(now())
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Popup {
  id         String   @id @default(uuid())
  name       String
  active     Boolean  @default(true)
  title      String   @default("")
  body       String   @default("")
  image      String?
  buttonText String?
  buttonLink String?
  style      Json
  audience   Json
  frequency  Json
  pages      String   @default("all")
  delaySec   Int      @default(2)
  priority   Int      @default(0)
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime @default(now())
}

model PopupView {
  id      String  @id @default(uuid())
  popupId String
  userId  String
  count   Int     @default(0)
  lastKey String?

  @@unique([popupId, userId])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  kind      String   @default("manual")
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model SupportMessage {
  id          String   @id @default(uuid())
  userId      String
  from        String
  text        String   @default("")
  image       String?
  readByAdmin Boolean  @default(false)
  readByUser  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model TeacherApplication {
  id              String    @id @default(uuid())
  userId          String
  name            String
  email           String
  phone           String
  city            String    @default("")
  qualification   String
  experienceYears Int       @default(0)
  subjects        String
  bio             String
  sampleLink      String?
  cv              String?
  status          String    @default("PENDING")
  note            String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
}
